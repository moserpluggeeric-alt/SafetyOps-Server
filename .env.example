# SafetyOps API Server — Environment Variables
# Copy this file to .env for local testing with a secret.
# Never commit .env to version control.
# In production, set these via Google Cloud Run environment variables.

# ── Required in production ────────────────────────────────────────────────────

# ENGINE_SECRET
# Shared secret between the API Server and SafetyOps_v2.html.
# SafetyOps sends this as {"type":"auth","secret":"<value>"} on WS connect.
# The server rejects engine connections that don't match within 5 seconds.
#
# Generate a secure value:
#   openssl rand -hex 32
#
# In SafetyOps browser console (one-time setup):
#   localStorage.setItem('safetyops-engine-secret', 'YOUR_VALUE_HERE')
#
# Leave unset for local development — all engine connections are accepted.
ENGINE_SECRET=

# CORS_ORIGIN
# Comma-separated list of allowed HTTP origins for the API.
# Example: https://mobile.safetyops.app,https://staging.safetyops.app
#
# Leave unset or set to * for local development (all origins allowed).
# In production, set to your Netlify / mobile client domain.
CORS_ORIGIN=*

# ── Set automatically by Cloud Run (do not override) ─────────────────────────

# PORT
# Cloud Run injects this automatically. Default is 8080 in Cloud Run, 3001 locally.
# Only set this manually for local testing on a non-standard port.
PORT=3001
